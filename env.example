# Copy to .env.local and fill in. .env* is gitignored; this file is committed.
# Never put a real key, secret or certificate in this file.

# --- Existing app configuration ---
GEMINI_API_KEY=                     # Google Gemini, used by /api/analyze and /api/normalise
OPENAI_API_KEY=                     # OpenAI, used by the placeholder image path
SEARCH_API_URL=                     # server-side room aesthetic search endpoint
NEXT_PUBLIC_SEARCH_API_URL=         # same endpoint, exposed to the browser
NEXT_PUBLIC_VISA_REAL_ORDERS=       # legacy v3 UI flag; "1" only changes checkout copy
DEV_ORIGIN=                         # extra allowed dev origin for next dev
HIGGSFIELD_BIN=                     # path to the Higgsfield CLI, placeholder generation
PLACEHOLDER_CACHE_DIR=              # override for .placeholder-cache
PLACEHOLDER_DISABLE_GENERATION=     # "1" to skip sprite generation entirely
PLACEHOLDER_MODEL=                  # placeholder sprite model id
PLACEHOLDER_QUALITY=                # placeholder sprite quality
PLACEHOLDER_TIMEOUT_MS=             # placeholder generation timeout in milliseconds

# --- Checkout mode ---
CHECKOUT_MODE=test                  # test | live — "test" simulates every retailer purchase
ENABLE_REAL_ORDERS=false            # must stay false; nothing in the UI can flip it

# --- Trusted Agent Protocol (no Visa account needed) ---
TAP_AGENT_ID=                       # any stable string, e.g. visa-room-agent
TAP_ED25519_PRIVATE_KEY=            # PKCS#8 PEM, generated locally, single line with \n
TAP_ED25519_PUBLIC_KEY=             # SPKI PEM, safe to publish
TAP_KEY_ID=                         # short label for the key, e.g. vra-key-1

# --- Visa Intelligent Commerce (Visa Developer Center project) ---
VISA_API_BASE_URL=https://sandbox.api.visa.com
VISA_VIC_API_KEY=                   # VIC onboarding
VISA_VIC_API_KEY_SS=                # VIC onboarding (shared secret)
VISA_EXTERNAL_CLIENT_ID=            # VIC onboarding
VISA_EXTERNAL_APP_ID=               # VIC onboarding
VISA_MLE_SERVER_CERT=               # downloaded from the VDP dashboard, PEM
VISA_MLE_PRIVATE_KEY=               # your key from the CSR you generated, PEM
VISA_KEY_ID=                        # shown next to the certificate in the dashboard
VISA_CONSUMER_ID=                   # any stable UUID you choose; keep it constant

# --- Visa Token Service (second onboarding; may not arrive) ---
VISA_VTS_API_BASE_URL=https://cert.api.visa.com
VISA_VTS_API_KEY=
VISA_VTS_API_KEY_SS=
VISA_ENROLLMENT_REFERENCE_ID=       # comes back from VTS tokenization

# --- Fallback: Visa Acceptance sandbox (published shared test merchant) ---
VA_RUN_ENVIRONMENT=apitest.visaacceptance.com
VA_MERCHANT_ID=
VA_MERCHANT_KEY_ID=
VA_MERCHANT_SECRET_KEY=
