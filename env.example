# Copy to .env.local and fill in. .env* is gitignored; this file is committed.
# Never put a real key, secret or certificate in this file.
# Optional overrides are commented out: leave them unset to use code defaults.

# --- Room analysis and product sourcing ---
GEMINI_API_KEY=                     # primary image analysis in /api/analyze
OPENAI_API_KEY=                     # fallback image analysis; also used when Gemini is absent
# /api/normalise is deterministic and does not call an AI provider.
# GEMINI_MODEL=                    # optional primary analysis model override
# GEMINI_FALLBACK_MODELS=          # optional comma-separated fallback model IDs
SERPAPI_KEY=                        # live Google Shopping sourcing
ELASTICSEARCH_URL=                  # optional indexed product catalog
ELASTICSEARCH_API_KEY=              # optional Elasticsearch API-key authentication
SEARCH_API_URL=                     # optional external search fallback; in-process sourcing runs first
NEXT_PUBLIC_SEARCH_API_URL=         # legacy public fallback; prefer SEARCH_API_URL, never embed secrets
DEV_ORIGIN=                         # extra allowed dev origin for next dev

# --- Stand-in generation and real product cutouts ---
# Stand-ins use the authenticated Higgsfield CLI, not OPENAI_API_KEY directly.
# HIGGSFIELD_BIN=                  # optional path to the Higgsfield CLI
# PLACEHOLDER_CACHE_DIR=           # optional writable cache directory; default .placeholder-cache
# PLACEHOLDER_DISABLE_GENERATION=  # "1" skips generated stand-ins
# PLACEHOLDER_MODEL=               # optional Higgsfield model ID
# PLACEHOLDER_QUALITY=             # optional generation quality
# PLACEHOLDER_TIMEOUT_MS=          # optional positive generation timeout in milliseconds
# CUTOUT_MODEL_PATH=               # optional local path to verified birefnet-lite-512.onnx
# Without a verified cached cutout model, the first cutout may download it.
# The override must match lib/productSegmentation.ts's pinned model checksum.

# --- Checkout mode ---
CHECKOUT_MODE=test                  # simulated retailer checkout; live ordering is not implemented
ENABLE_REAL_ORDERS=false            # keep false; setting both live flags causes the agent to refuse
NEXT_PUBLIC_VISA_REAL_ORDERS=        # legacy UI flag; does not implement or enable real ordering
PAYMENT_PROVIDER=                   # empty/simulated, or acceptance for sandbox authorization
# acceptance uses the configured Visa Acceptance sandbox merchant and published
# test-card data, with capture:false. It requires network access and credentials.
# The simulated walk can run locally; analysis, sourcing, images and optional
# Visa mandate requests can still require the network.

# --- Trusted Agent Protocol: our merchant verifier, local signing keys ---
TAP_AGENT_ID=                       # stable agent name, e.g. visa-room-agent
TAP_ED25519_PRIVATE_KEY=            # PKCS#8 PEM; generated locally, single line with \n
TAP_ED25519_PUBLIC_KEY=             # SPKI PEM; safe to publish
TAP_KEY_ID=                         # must match the public entry in data/tap-registry.json
TAP_VERIFY_BASE_URL=                # optional HTTP base for our /api/retailer/{retailer}/verify
# Unset uses the same verifier in-process. This is not a retailer integration.

# --- Visa Intelligent Commerce: separate from Visa Acceptance ---
VISA_API_BASE_URL=https://sandbox.api.visa.com
VISA_VIC_API_KEY=
VISA_VIC_API_KEY_SS=                # VIC shared secret
VISA_EXTERNAL_CLIENT_ID=            # optional client identifier from onboarding
VISA_EXTERNAL_APP_ID=               # optional application identifier from onboarding
VISA_MLE_SERVER_CERT=               # Visa MLE server certificate, PEM
VISA_MLE_PRIVATE_KEY=               # private key matching your MLE certificate setup, PEM
VISA_KEY_ID=                        # key identifier for that certificate setup
VISA_CONSUMER_ID=                   # optional stable consumer UUID

# --- Visa Token Service / enrollment reference ---
# The app's mandate route also requires VISA_ENROLLMENT_REFERENCE_ID.
# Supplying these values is not proof of successful authentication or enrollment.
VISA_VTS_API_BASE_URL=https://cert.api.visa.com
VISA_VTS_API_KEY=
VISA_VTS_API_KEY_SS=
VISA_ENROLLMENT_REFERENCE_ID=        # enrollment reference produced by card tokenization

# --- Visa Acceptance: configured sandbox merchant ---
VA_RUN_ENVIRONMENT=apitest.visaacceptance.com
VA_LIVE_TEST=                       # "1" opts the Acceptance integration test into real sandbox calls
VA_MERCHANT_ID=
VA_MERCHANT_KEY_ID=
VA_MERCHANT_SECRET_KEY=
# Credentials determine the sandbox merchant; do not assume a shared account.
# Leaving VA_LIVE_TEST unset keeps this optional integration test skipped.

# --- Google sign-in via Supabase ---
# These are public by design. Without them, the guest path remains available.
# Enable the Google provider and allow <origin>/auth/callback in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
